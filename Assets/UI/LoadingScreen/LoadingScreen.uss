/* ============================================================
   Folgen 21 - Pantalla de Carga
   ============================================================ */

.ls-root {
    background-image: url("../Art/loading_bg.png");
    background-size: cover;
    overflow: hidden;
}

/* ---------- logo ---------- */
.ls-logo {
    position: absolute;
    left: 48px; top: 42px;
}

.ls-logo-fila {
    flex-direction: row;
    align-items: baseline;
}

.ls-logo-a {
    font-size: 72px;
    color: rgb(255, 255, 255);
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.65);
    letter-spacing: 1px;
}

.ls-logo-b {
    font-size: 72px;
    color: rgb(255, 45, 155);
    text-shadow: 0 0 20px rgba(255, 45, 155, 0.7);
    margin-left: 12px;
}

.ls-logo-sub {
    font-size: 24px;
    letter-spacing: 5px;
    color: rgb(255, 45, 155);
    text-shadow: 0 0 10px rgba(255, 45, 155, 0.5);
    margin-top: -4px;
    margin-left: 6px;
}

/* ---------- bloque de carga ---------- */
.ls-bloque {
    position: absolute;
    right: 110px; bottom: 120px;
    width: 640px;
}

.ls-titulo {
    font-size: 46px;
    color: rgb(255, 255, 255);
    letter-spacing: 6px;
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.7);
    margin-bottom: 20px;
    -unity-text-align: middle-left;
}

.ls-fila-progreso {
    flex-direction: row;
    align-items: center;
}

.ls-track {
    flex-grow: 1;
    height: 24px;
    background-color: rgba(24, 14, 42, 0.85);
    border-color: rgba(255, 45, 155, 0.45);
    border-width: 1px;
    border-radius: 5px;
    overflow: hidden;
}

.ls-fill {
    height: 100%;
    background-image: linear-gradient(90deg, rgb(176, 22, 126), rgb(255, 45, 155), rgb(255, 95, 193));
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.25s;
}

.ls-porcentaje {
    font-size: 30px;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.7);
    margin-left: 20px;
    min-width: 86px;
    -unity-text-align: middle-right;
}

/* ---------- consejo ---------- */
.ls-tip {
    flex-direction: row;
    align-items: center;
    margin-top: 24px;
    background-color: rgba(16, 9, 30, 0.72);
    border-radius: 8px;
    padding: 12px 18px;
}

.ls-tip-icono {
    min-width: 26px;
    width: 26px; height: 26px;
    background-image: url("../Art/icon_info.png");
    background-size: cover;
    margin-right: 14px;
}

.ls-tip-texto {
    font-size: 23px;
    color: rgba(240, 234, 250, 0.95);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
}
