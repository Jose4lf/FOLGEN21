/* ============================================================
   Folgen 21 - HUD de juego
   Todos los elementos son picking-mode Ignore para no bloquear
   los clics hacia la escena.
   ============================================================ */

.hud-root { /* sin fondo: overlay transparente */ }

/* ---------- Jugador (arriba izquierda) ---------- */
.hud-jugador {
    position: absolute;
    left: 28px; top: 26px;
    flex-direction: row;
    align-items: center;
}

.hud-retrato {
    width: 108px;
    height: 108px;
}

.hud-retrato-img {
    position: absolute;
    left: 8px; top: 8px;
    width: 92px; height: 92px;
    background-image: url("../Art/portrait_jhoel.png");
    background-size: cover;
    border-radius: 8px;
}

.hud-retrato-marco {
    position: absolute;
    left: 0; top: 0;
    width: 108px; height: 108px;
    background-image: url("../Art/portrait_frame.png");
    background-size: cover;
}

.hud-nivel {
    position: absolute;
    left: -7px; bottom: -7px;
    min-width: 30px; height: 30px;
    background-color: rgb(255, 45, 110);
    border-color: rgba(255, 255, 255, 0.85);
    border-width: 2px;
    border-radius: 15px;
    font-size: 17px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.hud-datos {
    margin-left: 14px;
}

.hud-nombre {
    font-size: 27px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.7);
    margin-bottom: 8px;
}

.hud-barra-vida {
    width: 270px; height: 15px;
}

.hud-vida-relleno {
    background-image: linear-gradient(90deg, rgb(200, 30, 70), rgb(255, 59, 92));
}

.hud-vida-relleno {
    background-color: rgb(230, 40, 75);
}

.hud-energia-relleno {
    background-color: rgb(35, 155, 230);
}

/* ---------- Mision / tutorial ---------- */
.hud-mision {
    position: absolute;
    left: 28px; top: 168px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(28, 16, 48, 0.82);
    border-left-color: rgb(255, 210, 63);
    border-left-width: 3px;
    border-radius: 10px;
    padding: 14px 22px 14px 16px;
}

.hud-mision-icono {
    width: 42px; height: 42px;
    background-image: url("../Art/diamond_gold.png");
    background-size: cover;
    margin-right: 16px;
}

.hud-mision-titulo {
    font-size: 22px;
    letter-spacing: 1px;
    color: rgb(255, 210, 63);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
}

.hud-mision-objetivo {
    font-size: 23px;
    color: rgb(255, 255, 255);
    margin-top: 3px;
    white-space: nowrap;
}

/* ---------- Controles inferiores izquierdos ---------- */
.hud-controles {
    position: absolute;
    left: 28px; bottom: 28px;
}

.hud-controles-fila {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.hud-controles-texto {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.65);
}

/* ---------- Minimapa circular ---------- */
.hud-minimapa {
    position: absolute;
    right: 28px; top: 26px;
    width: 200px; height: 200px;
    background-color: rgba(20, 12, 36, 0.88);
    border-color: rgba(255, 255, 255, 0.28);
    border-width: 3px;
    border-radius: 100px;
    overflow: hidden;
}

.hud-minimapa-img {
    position: absolute;
    left: 0; top: 0;
    width: 100%; height: 100%;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.hud-minimapa-n {
    position: absolute;
    left: 0; right: 0; top: 3px;
    -unity-text-align: middle-center;
    font-size: 21px;
    color: rgba(255, 255, 255, 0.88);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.hud-minimapa-flecha {
    position: absolute;
    left: 83px; top: 83px;
    width: 34px; height: 34px;
    background-image: url("../Art/player_arrow.png");
    background-size: cover;
}

.hud-minimapa-marcador {
    position: absolute;
    left: 85px; top: 85px;
    width: 30px; height: 30px;
    background-image: url("../Art/minimap_marker.png");
    background-size: cover;
}

/* ---------- Caja de consejos ---------- */
.hud-tip {
    position: absolute;
    right: 30px; top: 252px;
    width: 390px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(28, 16, 48, 0.85);
    border-left-color: rgb(255, 45, 155);
    border-left-width: 3px;
    border-radius: 8px;
    padding: 13px 18px;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.hud-tip-icono {
    min-width: 27px;
    width: 27px; height: 27px;
    background-image: url("../Art/icon_warn.png");
    background-size: cover;
    margin-right: 13px;
}

.hud-tip-texto {
    font-size: 22px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}

/* ---------- Mira central ---------- */
.hud-mira {
    position: absolute;
    left: 50%; top: 50%;
    width: 0; height: 0;
}

.hud-mira-barra {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.9);
}

.hud-mira-izq    { left: -21px; top: -1px; width: 12px; height: 2px; }
.hud-mira-der    { left: 9px;   top: -1px; width: 12px; height: 2px; }
.hud-mira-arriba { left: -1px;  top: -21px; width: 2px; height: 12px; }
.hud-mira-abajo  { left: -1px;  top: 9px;  width: 2px; height: 12px; }

.hud-mira-punto {
    position: absolute;
    left: -1px; top: -1px;
    width: 2px; height: 2px;
    background-color: rgba(255, 255, 255, 0.95);
}

/* ---------- Marcador de mundo ---------- */
.hud-marcador-mundo {
    position: absolute;
    left: 900px; top: 500px; /* el codigo lo recoloca cada frame */
    align-items: center;
}

.hud-marcador-diamante {
    width: 36px; height: 36px;
    background-image: url("../Art/diamond_gold.png");
    background-size: cover;
    margin-bottom: 4px;
}

.hud-marcador-distancia {
    font-size: 24px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.85);
}

/* ---------- Skills ---------- */
.hud-acciones {
    position: absolute;
    right: 30px; bottom: 26px;
    align-items: flex-end;
}

.hud-skills {
    flex-direction: row;
    align-items: flex-end;
}

.hud-skill {
    align-items: center;
    margin-left: 20px;
}

.hud-skill-marco {
    width: 78px; height: 78px;
    background-size: cover;
    overflow: hidden;
}

.hud-skill-marco-q { background-image: url("../Art/skill_frame_q.png"); }
.hud-skill-marco-e { background-image: url("../Art/skill_frame_e.png"); }
.hud-skill-marco-r { background-image: url("../Art/skill_frame_r.png"); }
.hud-skill-marco-i { background-image: url("../Art/skill_frame_i.png"); }

.hud-skill-icono {
    position: absolute;
    left: 19px; top: 19px;
    width: 40px; height: 40px;
    background-size: cover;
    transition-property: opacity;
    transition-duration: 0.1s;
}

.hud-skill-icono-q { background-image: url("../Art/icon_skill_q.png"); }
.hud-skill-icono-e { background-image: url("../Art/icon_skill_e.png"); }
.hud-skill-icono-r { background-image: url("../Art/icon_skill_r.png"); }
.hud-skill-icono-i { background-image: url("../Art/icon_item.png"); }

.hud-skill-enf {
    position: absolute;
    left: 19px; top: 19px;
    width: 40px;
    background-color: rgba(8, 4, 16, 0.8);
    border-radius: 4px;
}

.hud-skill-cant {
    position: absolute;
    right: 6px; top: 2px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.hud-skill-tecla {
    font-size: 22px;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
    margin-top: 7px;
}

/* ---------- Municion ---------- */
.hud-municion {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 16px;
    margin-right: 4px;
}

.hud-municion-icono {
    width: 74px; height: 48px;
    background-image: url("../Art/icon_pistol.png");
    background-size: contain;
    margin-right: 14px;
    -unity-background-image-tint-color: rgb(235, 235, 250);
}

.hud-municion-actual {
    font-size: 44px;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.8);
    margin-bottom: 2px;
}

.hud-municion-reserva {
    font-size: 27px;
    color: rgb(185, 175, 214);
    margin-left: 8px;
    margin-bottom: 7px;
}
